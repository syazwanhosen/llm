{
  "name": "langgraph-rag-ollama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat with your PDF — a local RAG bot over a PDF (or website) using LangChain.js, LangGraph, and Ollama.",
  "scripts": {
    "web": "tsx src/server.ts",
    "ingest": "tsx src/index.ts ingest",
    "query": "tsx src/index.ts query",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "sample": "node scripts/make-sample-pdf.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@langchain/classic": "^1.0.34",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.4",
    "@langchain/ollama": "^1.2.7",
    "@langchain/textsplitters": "^1.0.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "jsdom": "^29.1.1",
    "langchain": "^1.4.4",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.4"
  }
}
