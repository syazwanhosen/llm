# Ollama connection
OLLAMA_BASE_URL=http://localhost:11434

# Models (pull with: ollama pull <name>)
CHAT_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text

# What to ingest
SOURCE_URL=https://js.langchain.com/docs/introduction/
CRAWL_MAX_DEPTH=1

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=4

# Where the persisted vector store is written
STORE_PATH=data/vector-store.json
